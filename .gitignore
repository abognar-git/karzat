# secrets
.env
.env.*
!.env.example

# raw API cache and derived database (rebuildable; the token's requests are logged, so keep the cache but out of git)
data/raw/*
!data/raw/.gitkeep
data/*.sqlite
data/*.sqlite-journal
data/*.db

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# editors / os
.cursor/
.vscode/
.DS_Store

# generated run state (rebuilt by sync/freshness commands)
data/*.json

# generated per-vote pages (rebuilt by scripts/build_site.py from committed data/derived inputs)
site/szavazas/
site/kepviselo/
