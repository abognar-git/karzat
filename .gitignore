# secrets
.env
.env.*
!.env.example

# raw API cache and derived database (rebuildable; the token's requests are logged, so keep the cache but out of git)
data/raw/*
!data/raw/.gitkeep
data/*.sqlite
data/*.sqlite-journal
data/*.db

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# editors / os
.cursor/
.vscode/
.DS_Store

# generated run state (rebuilt by sync/freshness commands)
data/*.json

# Everything the build writes under site/ is generated; only these seven files are the committed, --check-ed
# output. Listing directories to ignore meant a new page was tracked by default, and three of them were —
# frakciovaltas/, visszhang/ and sql/ each slipped in before the suite caught it. Inverted, a new page is
# ignored by default and has to be named to be kept, which is the safer way round.
site/*
!site/index.html
!site/404.html
!site/robots.txt
!site/tenyek.json
!site/assets/
site/assets/*
!site/assets/karzat.css
!site/assets/karzat.js
!site/assets/favicon.svg
!site/assets/favicon.ico
!site/assets/apple-touch-icon.png

# editor/session config
.claude/

# speech texts of the earlier cycles: tens of MB per cycle; fetch + derive them locally (sync-speech-texts, derive_speech_texts)
data/derived/speech_texts_ckl*.json.gz

# stray captures from debugging the chamber drawing; screenshots belong in the scratchpad
*.png
!site/assets/*.png
!tests/fixtures/*.png

# the traffic aggregate is operational, not a site input: it changes daily and nothing builds from it
data/derived/traffic.json

# DuckDB-WASM, vendored onto our own origin by scripts/fetch_duckdb.py; 35 MB does not belong in a history
site/assets/duckdb/

# axe-core is build tooling, not a site input: 580 kB of somebody else's minified JavaScript does not
# belong in this history. The lock beside it is committed, so a fetch either reproduces those bytes or
# stops. Same reasoning as site/assets/duckdb/.
reference/axe/
