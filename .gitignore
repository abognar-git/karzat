# secrets
.env
.env.*
!.env.example

# raw API cache and derived database (rebuildable; the token's requests are logged, so keep the cache but out of git)
data/raw/*
!data/raw/.gitkeep
data/*.sqlite
data/*.sqlite-journal
data/*.db

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# editors / os
.cursor/
.vscode/
.DS_Store

# generated run state (rebuilt by sync/freshness commands)
data/*.json

# generated per-vote / per-MP pages and every earlier cycle's tree (rebuilt by scripts/build_site.py from
# committed data/derived inputs; the cycle-42 tree alone is ~500 MB of HTML — 2,599 roll calls, 214 records)
site/szavazas/
site/kepviselo/
site/ckl*/
site/szemely/
site/adatok/
site/iromany/
site/kohezio/
site/szoros/
site/szamok/
site/modszer/
site/kereses/
site/feed/
site/felszolalas/
site/kepviselom/
site/bizottsag/
site/arcel/
site/lefedettseg/
site/assets/portre/

# editor/session config
.claude/

# speech texts of the earlier cycles: tens of MB per cycle; fetch + derive them locally (sync-speech-texts, derive_speech_texts)
data/derived/speech_texts_ckl*.json.gz

# stray captures from debugging the chamber drawing; screenshots belong in the scratchpad
*.png
!site/assets/*.png
!tests/fixtures/*.png
