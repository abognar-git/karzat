<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- karzat — the local half of the hybrid nightly.

     parlament.hu answers its API on the reader's network and serves its portal page to the datacenter's, so
     the sync runs HERE, on the machine whose connection the service accepts. While the AWS account's silent
     45-minute build cap stands (a new-account limit; a support case lifts it), this job runs the WHOLE
     chain — sync, handover to s3://karzat-ops, build, tests, README gate, deploy — and alerts the same SNS
     topic on failure. Once the cap is lifted: re-enable the karzat-nightly schedule (EventBridge Scheduler,
     eu-central-1) and put --sync-only back in place of --refresh-days/--handover/--sns-topic below.

     Install:   cp config/hu.ogykarzat.sync.plist ~/Library/LaunchAgents/
                launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/hu.ogykarzat.sync.plist
     Remove:    launchctl bootout gui/$(id -u)/hu.ogykarzat.sync
     Log:       ~/Library/Logs/karzat-sync.log

     A calendar job the Mac sleeps through fires once on the next wake, so a closed laptop shifts the sync
     rather than losing it; the scheduled build's --max-state-age guard turns a sync that stays missing into
     a loud failure and an email, never into a quietly stale site. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>hu.ogykarzat.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/host/.pyenv/versions/3.11.5/bin/python3</string>
        <string>-m</string>
        <string>scripts.nightly</string>
        <string>--profile</string>
        <string>karzat</string>
        <string>--refresh-days</string>
        <string>7</string>
        <string>--handover</string>
        <string>--sns-topic</string>
        <string>arn:aws:sns:eu-central-1:508888023472:karzat-nightly</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/host/Claude - Projects/karzat</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/host/Library/Logs/karzat-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/host/Library/Logs/karzat-sync.log</string>
</dict>
</plist>
